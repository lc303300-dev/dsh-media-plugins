{
  "name": "dsh-media-plugins",
  "version": "0.2.0",
  "description": "DSH Studio 媒体能力包：generate_image（统一媒体路由器，多级串行回退）、generate_video（即梦 Seedance，含测试通道）、describe_image（火山方舟看图）、skill_registry（业务 Skill 治理，SQLite FTS5）、project_pipeline（项目状态机+哈希锁定）、dt_batch（批次/预览/审阅页）、batch_image（确定性批量调度器）、video_to_gif（FFmpeg 双遍）、image_preview（1024px 预览）、完成通知",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lc303300-dev/dsh-media-plugins.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./tool-vision": "./tool-vision.js",
    "./Ws_tool-vision": "./tool-vision.js",
    "./tool-image-gen": "./tool-image-gen.js",
    "./Ws_tool-image-gen": "./tool-image-gen.js",
    "./tool-video-gen": "./tool-video-gen.js",
    "./Ws_tool-video-gen": "./tool-video-gen.js",
    "./tool-skill-registry": "./tool-skill-registry.js",
    "./Ws_tool-skill-registry": "./tool-skill-registry.js",
    "./tool-project": "./tool-project.js",
    "./Ws_tool-project": "./tool-project.js",
    "./tool-dt": "./tool-dt.js",
    "./Ws_tool-dt": "./tool-dt.js",
    "./tool-revision": "./tool-revision.js",
    "./Ws_tool-revision": "./tool-revision.js",
    "./tool-curator": "./tool-curator.js",
    "./Ws_tool-curator": "./tool-curator.js",
    "./tool-batch-image": "./tool-batch-image.js",
    "./Ws_tool-batch-image": "./tool-batch-image.js",
    "./tool-video-to-gif": "./tool-video-to-gif.js",
    "./Ws_tool-video-to-gif": "./tool-video-to-gif.js",
    "./tool-preview": "./tool-preview.js",
    "./Ws_tool-preview": "./tool-preview.js",
    "./tool-status": "./tool-status.js",
    "./Ws_tool-status": "./tool-status.js",
    "./notify": "./notify.js",
    "./Ws_completion-notify": "./notify.js",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "cordis.patch.yml",
    "skills/",
    "refs/",
    "scripts/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare": "tsdown",
    "build": "tsdown",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "sharp": "^0.35.3",
    "undici": "^8.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "link:../../DeepseekHarness/packages/llm/llm",
    "@deepseek-ai/dsh-tools": "link:../../DeepseekHarness/packages/core/tools",
    "tsdown": "^0.22.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
