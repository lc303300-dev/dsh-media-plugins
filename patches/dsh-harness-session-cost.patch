@@ -0,0 +1,80 @@
+/**
+ * Session RMB cost display helpers for the header cost window.
+ *
+ * The host `sessionCost` projection is the authoritative per-request cost; this
+ * module only formats it (RMB + breakdown lines) and mirrors the peak/off-peak
+ * window label for the display. Keep the window constants in sync with the
+ * host defaults in packages/llm/token-meter/src/cost-pricing.ts.
+ */
+
+import type { TokenUsageProjection } from '@deepseek-ai/dsh-token-meter/client'
+
+/** RMB per million tokens, one bucket per billed token class. */
+export interface CostPrice {
+  readonly inputMiss: number
+  readonly cacheHit: number
+  readonly cacheWrite: number
+  readonly output: number
+}
+
+/** One session's cost in yuan, split by bucket. */
+export interface SessionCost {
+  readonly input: number
+  readonly cacheHit: number
+  readonly cacheWrite: number
+  readonly output: number
+  readonly total: number
+}
+
+const PER_MILLION = 1_000_000
+
+/** Zero session cost (display fallback before any projection value arrives). */
+export function zeroCost(): SessionCost {
+  return { input: 0, cacheHit: 0, cacheWrite: 0, output: 0, total: 0 }
+}
+
+// Window info is a DISPLAY mirror of the host's DEFAULT_WINDOWS in
+// packages/llm/token-meter/src/cost-pricing.ts. Keep in sync: the authoritative
+// per-request pricing rides the host `sessionCost` projection, so this only
+// labels the CURRENT instant (峰/谷) for the user's awareness.
+const BEIJING_UTC_OFFSET_MINUTES = 480
+const OFF_PEAK_START_MINUTE = 30
+const OFF_PEAK_END_MINUTE = 510
+
+/**
+ * Whether `nowMs` falls in the (mirrored) off-peak window.
+ * @param nowMs - wall-clock epoch ms; defaults to the current time.
+ * @returns true when an off-peak discount applies right now.
+ */
+export function isOffPeakNow(nowMs: number = Date.now()): boolean {
+  const minute = Math.floor(((nowMs / 60_000) + BEIJING_UTC_OFFSET_MINUTES) % 1440 + 1440) % 1440
+  return minute >= OFF_PEAK_START_MINUTE && minute < OFF_PEAK_END_MINUTE
+}
+
+/**
+ * Format a yuan amount compactly: two decimals once the value reaches a cent,
+ * four decimals below it so a sub-cent session still shows a real figure.
+ */
+export function formatRmb(yuan: number): string {
+  if (!Number.isFinite(yuan) || yuan <= 0) return '¥0'
+  if (yuan >= 0.01) return `¥${yuan.toFixed(2)}`
+  return `¥${yuan.toFixed(4)}`
+}
+
+/** One-line hover breakdown for a token bucket. */
+export function breakdownLine(label: string, tokensText: string, yuan: number): string {
+  return `${label} ${tokensText} · ${formatRmb(yuan)}`
+}
+
+/** Legacy per-bucket compute used only as a display fallback (see cost-pricing on the host). */
+export function computeCost(usage: TokenUsageProjection | undefined, price: CostPrice): SessionCost {
+  const u = usage ?? { uncachedInputTokens: 0, outputTokens: 0, cacheReadTokens: 0, cacheWriteTokens: 0 }
+  const input = u.uncachedInputTokens * price.inputMiss / PER_MILLION
+  const cacheHit = u.cacheReadTokens * price.cacheHit / PER_MILLION
+  const cacheWrite = u.cacheWriteTokens * price.cacheWrite / PER_MILLION
+  const output = u.outputTokens * price.output / PER_MILLION
+  return { input, cacheHit, cacheWrite, output, total: input + cacheHit + cacheWrite + output }
+}
+
+/** Default full-price RMB/M table (mirror of the host default). */
+export const DEFAULT_PRICE: CostPrice = { inputMiss: 2, cacheHit: 0.5, cacheWrite: 0.5, output: 8 }
