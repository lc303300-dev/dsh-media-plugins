+describe('createPriceResolver (litellm auto-sync)', () => {
+  it('starts on fallback and swaps to the fetched table after refresh', async () => {
+    const resolver = createPriceResolver({
+      fetchTable: async () => ({ 'deepseek-v4-flash': { input_cost_per_token: 3 / 1e6, output_cost_per_token: 6 / 1e6 } }),
