@@ -0,0 +1,48 @@
+// Session RMB cost math: bucket folding under the default price table and the
+// compact RMB formatter.
+
+import { describe, expect, it } from 'vitest'
+import type { TokenUsageProjection } from '@deepseek-ai/dsh-token-meter/client'
+import { breakdownLine, computeCost, DEFAULT_PRICE, formatRmb } from '../src/client/chat/cost.ts'
+
+function usage(partial: Partial<TokenUsageProjection>): TokenUsageProjection {
+  return {
+    uncachedInputTokens: 0,
+    outputTokens: 0,
+    cacheReadTokens: 0,
+    cacheWriteTokens: 0,
+    ...partial,
+  }
+}
+
+describe('computeCost', () => {
+  it('folds zero buckets to a zero total', () => {
+    expect(computeCost(undefined, DEFAULT_PRICE)).toEqual({ input: 0, cacheHit: 0, cacheWrite: 0, output: 0, total: 0 })
+  })
+
+  it('prices each bucket at its RMB-per-million rate', () => {
+    const cost = computeCost(usage({ uncachedInputTokens: 1_000_000, cacheReadTokens: 1_000_000, cacheWriteTokens: 1_000_000, outputTokens: 1_000_000 }), DEFAULT_PRICE)
+    expect(cost.input).toBeCloseTo(2)
+    expect(cost.cacheHit).toBeCloseTo(0.5)
+    expect(cost.cacheWrite).toBeCloseTo(0.5)
+    expect(cost.output).toBeCloseTo(8)
+    expect(cost.total).toBeCloseTo(11)
+  })
+})
+
+describe('formatRmb', () => {
+  it('shows two decimals from a cent upward', () => {
+    expect(formatRmb(0)).toBe('¥0')
+    expect(formatRmb(1.234)).toBe('¥1.23')
+    expect(formatRmb(0.5)).toBe('¥0.50')
+  })
+  it('shows four decimals below a cent', () => {
+    expect(formatRmb(0.0071)).toBe('¥0.0071')
+  })
+})
+
+describe('breakdownLine', () => {
+  it('joins label, token text, and yuan amount', () => {
+    expect(breakdownLine('输出', '1.2K', 0.0096)).toBe('输出 1.2K · ¥0.0096')
+  })
+})
diff --git a/packages/llm/token-meter/src/cost-pricing.ts b/packages/llm/token-meter/src/cost-pricing.ts
new file mode 100644
index 0000000000..cb93f625aa
--- /dev/null
+++ b/packages/llm/token-meter/src/cost-pricing.ts
@@ -0,0 +1,145 @@
+/**
+ * Pure RMB cost pricing engine for the session cost window.
+ *
+ * The harness does not ship real currency pricing, so this module translates a
+ * litellm-style price row (USD per token) into RMB per million tokens, applies
+ * an optional FX conversion, and then applies a time-of-day (peak/off-peak)
+ * schedule to price a request at the moment it happened. Everything here is
+ * pure and deterministic so the cost projection stays replay-consistent.
+ *
+ * Sources:
+ *  - litellm `model_prices_and_context_window.json` (USD/token): https://github.com/BerriAI/litellm
+ *  - DeepSeek off-peak window (editable): https://api-docs.deepseek.com/zh-cn/quick_start/pricing
+ */
+
+/** RMB per million tokens, one bucket per billed token class. */
+export interface CostPrice {
+  /** Uncached (cache-miss) prompt input. */
+  readonly inputMiss: number
+  /** Cache-hit prompt input. */
+  readonly cacheHit: number
+  /** Context cache write. */
+  readonly cacheWrite: number
+  /** Completion output. */
+  readonly output: number
+}
+
+/** A request's cost split by token bucket, in yuan. */
+export interface StepCost {
+  readonly input: number
+  readonly cacheHit: number
+  readonly cacheWrite: number
+  readonly output: number
+  readonly total: number
+}
+
+/** Token counts (the durable projection shape) consumed by one step. */
+export interface StepUsage {
+  readonly uncachedInputTokens: number
+  readonly cacheReadTokens: number
+  readonly cacheWriteTokens: number
+  readonly outputTokens: number
+}
+
+/** A litellm row's price fields, in USD per token (some optional). */
+export interface LitellmPriceRow {
+  readonly input_cost_per_token?: number
+  readonly input_cost_per_token_cache_hit?: number
+  readonly input_cost_per_token_cache_write?: number
+  readonly output_cost_per_token?: number
+}
+
+const PER_MILLION = 1_000_000
+
+/** Default USD→RMB rate; override with pricing.fxRate config or auto-refresh. */
+export const DEFAULT_FX_RMB_PER_USD = 7.2
+
+/** Convert a litellm USD-per-token row to RMB per million tokens. */
+export function costPriceFromLitellm(row: LitellmPriceRow, fxRmbPerUsd: number): CostPrice {
+  const inputPerToken = row.input_cost_per_token ?? 0
+  return {
+    inputMiss: inputPerToken * PER_MILLION * fxRmbPerUsd,
+    cacheHit: (row.input_cost_per_token_cache_hit ?? inputPerToken) * PER_MILLION * fxRmbPerUsd,
+    cacheWrite: (row.input_cost_per_token_cache_write ?? 0) * PER_MILLION * fxRmbPerUsd,
+    output: (row.output_cost_per_token ?? 0) * PER_MILLION * fxRmbPerUsd,
+  }
+}
+
+/** Default full-price RMB/M table, used as the bundled fallback before a fetch. */
+export const DEFAULT_BASE_PRICE: CostPrice = {
+  inputMiss: 2,
+  cacheHit: 0.5,
+  cacheWrite: 0.5,
+  output: 8,
+}
+
+/** One time-of-day window with per-bucket multipliers (1 = full price). */
+export interface TimeWindow {
+  readonly startMinute: number
+  readonly endMinute: number
+  readonly inputFactor: number
+  readonly cacheHitFactor: number
+  readonly cacheWriteFactor: number
+  readonly outputFactor: number
+}
+
+/** Default DeepSeek-style off-peak window (00:30–8:30, Beijing). Editable. */
+export const DEFAULT_WINDOWS: readonly TimeWindow[] = [
+  { startMinute: 30, endMinute: 510, inputFactor: 0.25, cacheHitFactor: 0.25, cacheWriteFactor: 0.25, outputFactor: 0.125 },
+]
+
+/** Beijing is UTC+8, fixed (no DST). */
+export const BEIJING_UTC_OFFSET_MINUTES = 480
+
+/** Active window for a timestamp. */
+export function windowAt(
+  timestampMs: number,
+  windows: readonly TimeWindow[] = DEFAULT_WINDOWS,
+  tzOffsetMinutes = BEIJING_UTC_OFFSET_MINUTES,
+): TimeWindow | undefined {
+  const minute = Math.floor(((timestampMs / 60_000) + tzOffsetMinutes) % 1440 + 1440) % 1440
+  for (const window of windows) {
+    if (window.startMinute < window.endMinute) {
+      if (minute >= window.startMinute && minute < window.endMinute) return window
+    } else if (minute >= window.startMinute || minute < window.endMinute) return window
+  }
+  return undefined
+}
+
+/** Effective RMB/M price at a timestamp: full price, or window-discounted. */
+export function priceAtTs(
+  base: CostPrice,
+  timestampMs: number,
+  windows: readonly TimeWindow[] = DEFAULT_WINDOWS,
+): CostPrice {
+  const window = windowAt(timestampMs, windows)
+  if (window === undefined) return base
+  return {
+    inputMiss: base.inputMiss * window.inputFactor,
+    cacheHit: base.cacheHit * window.cacheHitFactor,
+    cacheWrite: base.cacheWrite * window.cacheWriteFactor,
+    output: base.output * window.outputFactor,
+  }
+}
+
+/** Price one step's token usage under an effective RMB/M table. */
+export function stepCost(usage: StepUsage, price: CostPrice): StepCost {
+  const input = usage.uncachedInputTokens * price.inputMiss / PER_MILLION
+  const cacheHit = usage.cacheReadTokens * price.cacheHit / PER_MILLION
+  const cacheWrite = usage.cacheWriteTokens * price.cacheWrite / PER_MILLION
+  const output = usage.outputTokens * price.output / PER_MILLION
+  return { input, cacheHit, cacheWrite, output, total: input + cacheHit + cacheWrite + output }
+}
+
+/** Zero cost (used before any usage is reported). */
+export function zeroCost(): StepCost {
+  return { input: 0, cacheHit: 0, cacheWrite: 0, output: 0, total: 0 }
+}
+
+/** Bundled fallback row (USD/token) for a DeepSeek-style chat model. */
+export const DEEPSEEK_FALLBACK_ROW: LitellmPriceRow = {
+  input_cost_per_token: DEFAULT_BASE_PRICE.inputMiss / PER_MILLION / DEFAULT_FX_RMB_PER_USD,
+  input_cost_per_token_cache_hit: DEFAULT_BASE_PRICE.cacheHit / PER_MILLION / DEFAULT_FX_RMB_PER_USD,
+  input_cost_per_token_cache_write: DEFAULT_BASE_PRICE.cacheWrite / PER_MILLION / DEFAULT_FX_RMB_PER_USD,
+  output_cost_per_token: DEFAULT_BASE_PRICE.output / PER_MILLION / DEFAULT_FX_RMB_PER_USD,
+}
