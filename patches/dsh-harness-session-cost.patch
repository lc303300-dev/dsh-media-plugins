@@ -20,6 +20,8 @@ import type {
 } from './types.ts'
 import { contextBreakdownProjectionDefinition } from './breakdown-projection.ts'
 import { contextPressureProjectionDefinition, tokenUsageProjectionDefinition } from './usage-projection.ts'
+import { buildSessionCostProjection } from './session-cost-projection.ts'
+import { createPriceResolver } from './price-source.ts'
 import { estimateContent, estimateHeader, estimateMessage, ROLE_OVERHEAD } from './estimate.ts'
 import { foldSurfaceTokens } from './surface-fold.ts'
 
@@ -64,6 +66,20 @@ function validateConfigKeys(config: TokenMeterConfig): void {
   }
 }
 
+/** Periodic litellm refresh interval in ms; env `DSH_COST_REFRESH_MS` (0 disables). */
+const DEFAULT_PRICING_REFRESH_MS = 6 * 60 * 60 * 1000
+
+function pricingRefreshMs(): number {
+  const raw = Number(process.env.DSH_COST_REFRESH_MS)
+  return Number.isFinite(raw) && raw >= 0 ? raw : DEFAULT_PRICING_REFRESH_MS
+}
+
+/** USD→RMB rate; env `DSH_COST_FX_RMB` overrides the default. */
