index 0000000000..f20f74c772
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/chat/CostWindow.tsx
@@ -0,0 +1,77 @@
+// Session-header cost window: a compact pill that shows the current session's
+// billed tokens (input / cache-hit / cache-write / output) and RMB total, with
+// a hover breakdown of the RMB cost per bucket. RMB rides the durable
+// `sessionCost` projection (priced per request instant on the host); token
+// counts ride `tokenUsage`.
+
+import { useMemo } from 'react'
+import { Tooltip } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+// Type-only: pulls the conversation slot/keys SlotMap augmentation for PropsRuntime.
+import type {} from '../contract/slots.ts'
+import { NS } from '../locales.ts'
+import { breakdownLine, formatRmb, isOffPeakNow, zeroCost } from './cost.ts'
+import { formatTokens } from './StatsLine.tsx'
+import css from './CostWindow.module.css'
+
+/** Full props for the session-header cost window. */
+export type CostWindowProps =
+  PropsRuntime<'conversation.session.header.actions'> & PropsLocale<typeof NS>
+
+/**
+ * One click-through cost readout for the open session.
+ * @param props - runtime session kit (sessionId, useProjection) plus the locale seat.
+ * @returns the pill (and its hover breakdown), or null when nothing is billed yet.
+ */
+export function CostWindow({ useProjection, t }: CostWindowProps) {
+  const usage = useProjection('tokenUsage')
+  const cost = useProjection('sessionCost')
+  const costValue = useMemo(() => cost ?? zeroCost(), [cost])
+
+  if (usage === undefined || cost === undefined) return null
+
+  const inputTokens = formatTokens(usage.uncachedInputTokens ?? 0)
+  const cacheHitTokens = formatTokens(usage.cacheReadTokens ?? 0)
+  const cacheWriteTokens = formatTokens(usage.cacheWriteTokens ?? 0)
+  const outputTokens = formatTokens(usage.outputTokens ?? 0)
+  // Current peak/off-peak (display-only label; the authoritative per-request
+  // pricing rides the host sessionCost projection).
+  const offPeak = isOffPeakNow()
+
+  // Compact always-visible summary: the four token counts plus the total RMB.
+  const summary = [
+    `${t('cost.inputShort')}${inputTokens}`,
+    `${t('cost.cacheHitShort')}${cacheHitTokens}`,
+    `${t('cost.cacheWriteShort')}${cacheWriteTokens}`,
+    `${t('cost.outputShort')}${outputTokens}`,
+  ].join(' / ')
+
+  // Hover breakdown: per-bucket RMB, current window, then the total.
+  const breakdown = [
+    breakdownLine(t('cost.input'), inputTokens, costValue.input),
+    breakdownLine(t('cost.cacheHit'), cacheHitTokens, costValue.cacheHit),
+    breakdownLine(t('cost.cacheWrite'), cacheWriteTokens, costValue.cacheWrite),
+    breakdownLine(t('cost.output'), outputTokens, costValue.output),
+    `${t('cost.windowNow')} ${t(offPeak ? 'cost.offPeak' : 'cost.peak')}${offPeak ? `（${t('cost.offPeakNote')}）` : ''}`,
+    `${t('cost.totalLabel')} ${formatRmb(costValue.total)}`,
+  ].join('\n')
+
+  const ariaLabel = `${t('cost.aria')} ${summary} ${t('cost.totalLabel')} ${formatRmb(costValue.total)}`
+
+  return (
+    <Tooltip label={breakdown} side="bottom" delayMs={300} maxWidth={280}>
+      <button
+        type="button"
+        className={css.trigger}
+        aria-label={ariaLabel}
+      >
+        <span className={offPeak ? css.badgeOffPeak : css.badgePeak}>
+          {t(offPeak ? 'cost.offPeakShort' : 'cost.peakShort')}
+        </span>
+        <span className={css.total}>{formatRmb(costValue.total)}</span>
+        <span className={css.sep} aria-hidden>·</span>
+        <span className={css.summary}>{summary}</span>
+      </button>
+    </Tooltip>
+  )
+}
