@@ -0,0 +1,132 @@
+/**
+ * Incremental, time-aware session cost projection.
+ *
+ * Each billed step (assistant usage) is priced by the step's OWN model and
+ * wall-clock instant, using a price resolver injected at registration time. The
+ * fold is INCREMENTAL: a previously-seen turn/step is replaced (not re-added),
+ * so a repeated final-usage sample never double counts, and a price-table
+ * refresh never rewrites history (① 增量计费).
+ *
+ * @module @deepseek-ai/dsh-token-meter/session-cost-projection
+ */
+
+import { z } from 'zod'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import type { TokenUsage } from '@deepseek-ai/dsh-llm'
+import type { CostPrice, StepCost } from './cost-pricing.ts'
+import { stepCost, zeroCost } from './cost-pricing.ts'
+
+/** Effective price (RMB/M) for a (model, instant) pair; the injected resolver. */
+export type CostPriceAt = (model: string | undefined, timestampMs: number) => CostPrice
+
+/** Fold state: plain JSON so the projection cache can persist it. */
+export interface SessionCostState {
+  readonly model: string
+  readonly totals: StepCost
+  readonly last: { turn: number; step: number; cost: StepCost } | null
+}
+
+const costSchema = z.object({
+  input: z.number().nonnegative(),
+  cacheHit: z.number().nonnegative(),
+  cacheWrite: z.number().nonnegative(),
+  output: z.number().nonnegative(),
+  total: z.number().nonnegative(),
+}).strict()
+
+const stateSchema = z.object({
+  model: z.string(),
+  totals: costSchema,
+  last: z.object({ turn: z.number().int().nonnegative(), step: z.number().int().nonnegative(), cost: costSchema }).nullable(),
+}).strict()
+
+/** Firm up a step's usage into the four disjoint billed buckets. */
+function bucketsOf(usage: TokenUsage): {
+  uncachedInputTokens: number
+  cacheReadTokens: number
+  cacheWriteTokens: number
+  outputTokens: number
+} {
+  return {
+    uncachedInputTokens: usage.inputTokens,
+    cacheReadTokens: usage.cacheReadTokens ?? 0,
+    cacheWriteTokens: usage.cacheWriteTokens ?? 0,
+    outputTokens: usage.outputTokens,
+  }
+}
+
+/** Extract the usage + step identity carried by a chunk/message, if any. */
+function usageOf(event: SessionEvent): { turn: number; step: number; usage: TokenUsage } | undefined {
+  if (event.type === 'assistant/chunk' && event.data.chunk.type === 'usage') {
+    return { turn: event.data.turn, step: event.data.step, usage: event.data.chunk.usage }
+  }
+  if (event.type === 'assistant/message' && event.data.usage !== undefined) {
+    return { turn: event.data.turn, step: event.data.step, usage: event.data.usage }
+  }
+  return undefined
+}
+
+/** Build the `sessionCost` projection unit with an injected price resolver. */
+export function buildSessionCostProjection(priceAt: CostPriceAt): {
+  readonly key: 'sessionCost'
+  readonly stateVersion: number
+  readonly stateSchema: typeof stateSchema
+  readonly init: () => SessionCostState
+  readonly apply: (state: SessionCostState, event: SessionEvent) => SessionCostState
+  readonly wire: { readonly viewSchema: typeof costSchema; readonly view: (state: SessionCostState) => StepCost }
+} {
+  return {
+    key: 'sessionCost',
+    stateVersion: 1,
+    stateSchema,
+    init: () => ({ model: '', totals: zeroCost(), last: null }),
+    apply: (state, event) => {
+      let nextModel = state.model
+      if (event.type === 'request/header') {
+        nextModel = event.data.header?.config?.model ?? state.model
+      }
+
+      const stepped = usageOf(event)
+      if (stepped === undefined) {
+        return nextModel === state.model ? state : { ...state, model: nextModel }
+      }
+
+      const { turn, step, usage } = stepped
+      const cost = stepCost(bucketsOf(usage), priceAt(nextModel, event.time))
+
+      if (state.last !== null && state.last.turn === turn && state.last.step === step) {
+        const previous = state.last.cost
+        return {
+          model: nextModel,
+          totals: {
+            input: state.totals.input - previous.input + cost.input,
+            cacheHit: state.totals.cacheHit - previous.cacheHit + cost.cacheHit,
+            cacheWrite: state.totals.cacheWrite - previous.cacheWrite + cost.cacheWrite,
+            output: state.totals.output - previous.output + cost.output,
+            total: state.totals.total - previous.total + cost.total,
+          },
+          last: { turn, step, cost },
+        }
+      }
+
+      return {
+        model: nextModel,
+        totals: {
+          input: state.totals.input + cost.input,
+          cacheHit: state.totals.cacheHit + cost.cacheHit,
+          cacheWrite: state.totals.cacheWrite + cost.cacheWrite,
+          output: state.totals.output + cost.output,
+          total: state.totals.total + cost.total,
+        },
+        last: { turn, step, cost },
+      }
+    },
+    wire: { viewSchema: costSchema, view: state => state.totals },
+  }
+}
+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionStateMap {
+    sessionCost: SessionCostState
+  }
+}
