index 0000000000..9b1a2c3a86
--- /dev/null
+++ b/packages/llm/token-meter/src/price-source.ts
@@ -0,0 +1,322 @@
+/**
+ * Host pricing source: fetches the litellm community price table over the
+ * outbound proxy (read from HTTPS_PROXY/HTTP_PROXY/ALL_PROXY, this host =
+ * 127.0.0.1:7897), converts USD/token to RMB (FX), applies the time-of-day
+ * window, and yields a per-(model, instant) price resolver for the
+ * `sessionCost` projection. A bundled DeepSeek fallback keeps billing working
+ * when the fetch fails or the model id is unknown.
+ *
+ * @module @deepseek-ai/dsh-token-meter/price-source
+ */
+
+import { connect } from 'node:net'
+import { connect as tlsConnect, type TLSSocket } from 'node:tls'
+import { request as httpsRequest } from 'node:https'
+import type { IncomingMessage } from 'node:http'
+import type { CostPrice } from './cost-pricing.ts'
+import {
+  costPriceFromLitellm, DEFAULT_BASE_PRICE, DEFAULT_FX_RMB_PER_USD, DEFAULT_WINDOWS,
+  DEEPSEEK_FALLBACK_ROW, priceAtTs, type LitellmPriceRow, type TimeWindow,
+} from './cost-pricing.ts'
+
+/** Effective RMB/M price for one (model, instant). */
+export type CostPriceAt = (model: string | undefined, timestampMs: number) => CostPrice
+
+/** A fetched litellm table keyed by model id. */
+export type LitellmTable = Readonly<Record<string, LitellmPriceRow>>
+
+export interface PricingConfig {
+  readonly litellmUrl?: string
+  readonly table?: LitellmTable
+  readonly fxRmbPerUsd?: number
+  readonly windows?: readonly TimeWindow[]
+  readonly modelAliases?: Readonly<Record<string, string>>
+}
+
+/** Default aliases: variant ids that price the same as a canonical model. */
+export const MODEL_ALIASES: Readonly<Record<string, string>> = {
+  'deepseek-v4-flash-vision-exp': 'deepseek-v4-flash',
+}
+
+/** Parse a litellm JSON response into a model-id → row table. */
+export function parseLitellmTable(raw: string): LitellmTable {
+  const parsed: unknown = JSON.parse(raw)
+  if (typeof parsed !== 'object' || parsed === null) return {}
+  const out: Record<string, LitellmPriceRow> = {}
+  for (const [id, value] of Object.entries(parsed as Record<string, unknown>)) {
+    if (typeof value !== 'object' || value === null) continue
+    const row = value as Record<string, unknown>
+    const pick = (k: string): number | undefined => {
+      const v = row[k]
+      return typeof v === 'number' ? v : undefined
+    }
+    out[id] = {
+      ...pick('input_cost_per_token') !== undefined ? { input_cost_per_token: pick('input_cost_per_token')! } : {},
+      ...pick('input_cost_per_token_cache_hit') !== undefined ? { input_cost_per_token_cache_hit: pick('input_cost_per_token_cache_hit')! } : {},
+      ...pick('input_cost_per_token_cache_write') !== undefined ? { input_cost_per_token_cache_write: pick('input_cost_per_token_cache_write')! } : {},
+      ...pick('output_cost_per_token') !== undefined ? { output_cost_per_token: pick('output_cost_per_token')! } : {},
+    }
+  }
+  return out
+}
+
+/** Find the closest litellm row for a model id (exact, then a prefix match). */
+export function rowForModel(table: LitellmTable, model: string | undefined): LitellmPriceRow | undefined {
+  if (model === undefined) return undefined
+  if (table[model] !== undefined) return table[model]
+  const lower = model.toLowerCase()
+  for (const [id, row] of Object.entries(table)) {
+    if (id.toLowerCase().includes(lower) || lower.includes(id.toLowerCase())) return row
+  }
+  return undefined
+}
+
+/** Build a static resolver: row→RMB/M via FX, then time-window discount. */
+export function buildCostPriceAt(config: PricingConfig): CostPriceAt {
+  const fx = config.fxRmbPerUsd ?? DEFAULT_FX_RMB_PER_USD
+  const windows = config.windows ?? DEFAULT_WINDOWS
+  const table = config.table ?? {}
+  const aliases = config.modelAliases ?? MODEL_ALIASES
+  const cache = new Map<string, CostPrice>()
+
+  return (model, timestampMs) => {
+    const key = `${model ?? ''}:${timestampMs}`
+    const hit = cache.get(key)
+    if (hit !== undefined) return hit
+    const canonical = model === undefined ? undefined : (aliases[model] ?? model)
+    const row = rowForModel(table, canonical) ?? DEEPSEEK_FALLBACK_ROW
+    let price: CostPrice
+    try {
+      price = costPriceFromLitellm(row, fx)
+    } catch {
+      price = DEFAULT_BASE_PRICE
+    }
+    const effective = priceAtTs(price, timestampMs, windows)
+    cache.set(key, effective)
+    return effective
+  }
+}
+
+/** `(model, timestampMs)` resolver for the no-table case (pure fallback). */
+export function bundledCostPriceAt(config?: PricingConfig): CostPriceAt {
+  return buildCostPriceAt(config ?? {})
+}
+
+/** A live, refreshable price resolver (fetches litellm over the proxy). */
+export interface PriceResolver {
+  readonly priceAt: CostPriceAt
+  refresh(): Promise<void>
+  dispose(): void
+}
+
+/** Default litellm price-table URL (community-maintained USD/token). */
+export const DEFAULT_LITELLM_URL = 'https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json'
+
+export interface PriceResolverOptions extends PricingConfig {
+  readonly litellmUrl?: string
+  readonly proxy?: string
+  readonly refreshMs?: number
+  readonly fetchTable?: (url: string) => Promise<LitellmTable>
+}
+
+/** Build a live resolver that starts on the fallback and swaps in litellm. */
+export function createPriceResolver(options: PriceResolverOptions = {}): PriceResolver {
+  let table = options.table ?? {}
+  let disposed = false
+  let timer: ReturnType<typeof setInterval> | undefined
+  const fx = options.fxRmbPerUsd ?? DEFAULT_FX_RMB_PER_USD
+  const windows = options.windows ?? DEFAULT_WINDOWS
+  const aliases = options.modelAliases ?? MODEL_ALIASES
+  const url = options.litellmUrl ?? DEFAULT_LITELLM_URL
+  const cache = new Map<string, CostPrice>()
+
+  const priceAt: CostPriceAt = (model, timestampMs) => {
+    const key = `${model ?? ''}:${timestampMs}`
+    const hit = cache.get(key)
+    if (hit !== undefined) return hit
+    const canonical = model === undefined ? undefined : (aliases[model] ?? model)
+    const row = rowForModel(table, canonical) ?? DEEPSEEK_FALLBACK_ROW
+    let price: CostPrice
+    try {
+      price = costPriceFromLitellm(row, fx)
+    } catch {
+      price = DEFAULT_BASE_PRICE
+    }
+    const effective = priceAtTs(price, timestampMs, windows)
+    cache.set(key, effective)
+    return effective
+  }
+
+  const refresh = async (): Promise<void> => {
+    try {
+      const fetched = await (options.fetchTable === undefined
+        ? fetchLitellmTable(url, options.proxy)
+        : options.fetchTable(url))
+      if (!disposed) {
+        table = fetched
+        cache.clear()
+      }
+    } catch {
+      // Keep the current table; never fail the host.
+    }
+  }
+
+  if (options.refreshMs !== undefined && options.refreshMs > 0) {
+    timer = setInterval(() => { void refresh() }, options.refreshMs)
+  }
+
+  return { priceAt, refresh, dispose: () => { disposed = true; if (timer !== undefined) { clearInterval(timer); timer = undefined } } }
+}
+
+const PROXY_URL = process.env.HTTPS_PROXY ?? process.env.HTTP_PROXY ?? process.env.ALL_PROXY ?? ''
+
+type ProxyType = 'http' | 'socks5'
+interface ProxyEndpoint { host: string; port: number; type: ProxyType }
+
+/** Parse a proxy URL into host/port and type. */
+function proxyTarget(proxyUrl: string): ProxyEndpoint | null {
+  const trimmed = proxyUrl.trim()
+  const match = /^(socks5?|https?):\/\/([^:/]+):(\d+)/.exec(trimmed)
+  if (match !== null) {
+    const scheme = match[1]!.toLowerCase()
+    return { host: match[2]!, port: Number(match[3]), type: scheme.startsWith('socks') ? 'socks5' : 'http' }
+  }
+  const bare = /^([^:/]+):(\d+)/.exec(trimmed)
+  if (bare !== null) return { host: bare[1]!, port: Number(bare[2]), type: 'http' }
+  return null
+}
+
+const FETCH_TIMEOUT_MS = 15_000
+
+/** Await a TLS socket through the proxy (HTTP CONNECT or SOCKS5). */
+function tunneledTls(hostname: string, port: number, proxy: ProxyEndpoint): Promise<TLSSocket> {
+  return proxy.type === 'http' ? httpConnectTls(hostname, port, proxy) : socks5Tls(hostname, port, proxy)
+}
+
+function httpConnectTls(hostname: string, port: number, proxy: ProxyEndpoint): Promise<TLSSocket> {
+  return new Promise((resolve, reject) => {
+    const socket = connect(proxy.port, proxy.host, () => {
+      socket.write(`CONNECT ${hostname}:${port} HTTP/1.1\r\nHost: ${hostname}:${port}\r\n\r\n`)
+    })
+    const timeout = setTimeout(() => { socket.destroy(); reject(new Error('pricing: proxy fetch timed out')) }, FETCH_TIMEOUT_MS)
+    let buffer = ''
+    socket.on('data', (chunk) => {
+      buffer += chunk.toString('latin1')
+      if (!buffer.includes('\r\n\r\n')) return
+      clearTimeout(timeout)
+      socket.removeAllListeners('data')
+      const statusLine = buffer.split('\r\n', 1)[0] ?? ''
+      const status = Number(/HTTP\/1\.1 (\d{3})/.exec(statusLine)?.[1]) ?? 0
+      if (status !== 200) { socket.destroy(); reject(new Error(`pricing: proxy CONNECT failed (${statusLine})`)); return }
+      finishTls(socket, hostname, resolve, reject)
+    })
+    socket.once('error', reject)
+  })
+}
+
+function socks5Tls(hostname: string, port: number, proxy: ProxyEndpoint): Promise<TLSSocket> {
+  return new Promise((resolve, reject) => {
+    const socket = connect(proxy.port, proxy.host, () => {
+      socket.write(Buffer.from([0x05, 0x01, 0x00]))
+    })
+    const timeout = setTimeout(() => { socket.destroy(); reject(new Error('pricing: proxy fetch timed out')) }, FETCH_TIMEOUT_MS)
+    let stage = 0
+    let buf = Buffer.alloc(0)
+    socket.on('data', (chunk) => {
+      buf = Buffer.concat([buf, chunk])
+      if (stage === 0) {
+        if (buf.length < 2) return
+        if (buf[0] !== 0x05 || buf[1] !== 0x00) { socket.destroy(); reject(new Error('pricing: SOCKS auth failed')); return }
+        buf = buf.subarray(2)
+        stage = 1
+        const domain = Buffer.from(hostname, 'utf8')
+        socket.write(Buffer.concat([
+          Buffer.from([0x05, 0x01, 0x00, 0x03, domain.length]),
+          domain,
+          Buffer.from([(port >> 8) & 0xff, port & 0xff]),
+        ]))
+        return
+      }
+      if (buf.length < 4) return
+      const rep = buf[1]
+      if (rep !== 0) { socket.destroy(); reject(new Error(`pricing: SOCKS connect failed (rep ${rep})`)); return }
+      const atyp = buf[3]
+      let headerLen = 4
+      if (atyp === 0x01) headerLen += 4
+      else if (atyp === 0x03) {
+        if (buf.length < 5) return
+        headerLen += 1 + buf[4]!
+      } else if (atyp === 0x04) headerLen += 16
+      else { socket.destroy(); reject(new Error('pricing: SOCKS address type unsupported')); return }
+      if (buf.length < headerLen + 2) return
+      clearTimeout(timeout)
+      socket.removeAllListeners('data')
+      finishTls(socket, hostname, resolve, reject)
+    })
+    socket.once('error', reject)
+  })
+}
+
+function finishTls(
+  socket: import('node:net').Socket,
+  hostname: string,
+  resolve: (v: TLSSocket) => void,
+  reject: (e: unknown) => void,
+): void {
+  const tls = tlsConnect({ socket, servername: hostname })
+  tls.once('secureConnect', () => resolve(tls))
+  tls.once('error', reject)
+}
+
+/** Await one tunneled TLS socket; then issue an HTTPS GET and read the body. */
+async function fetchViaProxy(url: string, proxy?: string): Promise<string> {
+  const target = new URL(url)
+  const proxyUrl = proxy ?? PROXY_URL
+  const proxyEndpoint = proxyTarget(proxyUrl)
+  if (proxyEndpoint === null) {
+    throw new Error('pricing: no proxy configured (set HTTPS_PROXY/HTTP_PROXY/ALL_PROXY) for external fetch')
+  }
+  const port = target.port === '' ? 443 : Number(target.port)
+  const tls = await tunneledTls(target.hostname, port, proxyEndpoint)
+  const body = await httpsGetOverSocket(tls, target.hostname, port, target.pathname + target.search)
+  tls.destroy()
+  return body
+}
+
+/** One HTTPS GET hand-written over an already-tunneled TLS socket. */
+function httpsGetOverSocket(
+  tls: TLSSocket,
+  hostname: string,
+  port: number,
+  path: string,
+  hostHeader?: string,
+): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const req = httpsRequest({
+      createConnection: () => tls,
+      hostname,
+      port,
+      path,
+      method: 'GET',
+      headers: { host: hostHeader ?? hostname, accept: 'application/json' },
+    }, (res: IncomingMessage) => {
+      const chunks: Buffer[] = []
+      res.on('data', (c: Buffer) => chunks.push(c))
+      res.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')))
+      res.on('error', reject)
+    })
+    req.once('error', reject)
+    req.setTimeout(FETCH_TIMEOUT_MS, () => { req.destroy(new Error('pricing: proxy fetch timed out')) })
+    req.end()
+  })
+}
+
+/** Fetch the litellm table over proxy, returning parsed rows (throws on failure). */
+export async function fetchLitellmTable(url: string, proxy?: string): Promise<LitellmTable> {
+  const body = await fetchViaProxy(url, proxy)
+  return parseLitellmTable(body)
+}
+
+export interface PricingConfigWithTable extends PricingConfig {
+  readonly table?: LitellmTable
+}
