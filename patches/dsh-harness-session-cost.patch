+// RMB cost pricing engine + incremental sessionCost projection fold.
+
+import { describe, expect, it } from 'vitest'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import {
+  costPriceFromLitellm, DEFAULT_BASE_PRICE, priceAtTs, stepCost, windowAt,
+} from '../src/cost-pricing.ts'
+import { buildSessionCostProjection } from '../src/session-cost-projection.ts'
+import { buildCostPriceAt, bundledCostPriceAt, createPriceResolver, parseLitellmTable, rowForModel } from '../src/price-source.ts'
+
+const BASIC_PRICE = { inputMiss: 2, cacheHit: 0.5, cacheWrite: 0.5, output: 8 }
+
+function header(model: string, seq = 1, time = 0): SessionEvent {
+  return { type: 'request/header', seq, time, data: { header: { config: { provider: 'p', model } } } } as never as SessionEvent
+}
+function usageEvt(turn: number, step: number, usage: Record<string, number>, time: number, seq = 5): SessionEvent {
+  return { type: 'assistant/message', seq, time, data: { turn, step, usage } } as never as SessionEvent
+}
+const USAGE = { inputTokens: 1_000_000, cacheReadTokens: 0, cacheWriteTokens: 0, outputTokens: 1_000_000 }
+
+const beijingMinute = (minute: number): number => (minute - 480) * 60_000
+const PEAK_MS = beijingMinute(12 * 60)
+const OFF_PEAK_MS = beijingMinute(2 * 60)
+
+describe('costPriceFromLitellm', () => {
+  it('converts USD/token to RMB per million under FX', () => {
+    const price = costPriceFromLitellm(
+      { input_cost_per_token: 2 / 1e6 / 7.2, output_cost_per_token: 8 / 1e6 / 7.2, input_cost_per_token_cache_hit: 0.5 / 1e6 / 7.2 },
+      7.2,
+    )
+    expect(price.inputMiss).toBeCloseTo(2)
+    expect(price.cacheHit).toBeCloseTo(0.5)
