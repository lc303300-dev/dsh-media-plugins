+  it('replaces the same turn/step sample instead of double-counting', () => {
+    const def = buildSessionCostProjection(priceAt)
+    let state = def.apply(def.init(), header('m'))
+    state = def.apply(state, usageEvt(1, 1, USAGE, PEAK_MS))
+    const again = def.wire!.view(def.apply(state, usageEvt(1, 1, USAGE, PEAK_MS)))
+    expect(again.total).toBeCloseTo(10)
+  })
+
+  it('prices an off-peak event cheaper than a peak one', () => {
+    const def = buildSessionCostProjection(priceAt)
+    const peak = def.wire!.view(def.apply(def.apply(def.init(), header('m')), usageEvt(1, 1, USAGE, PEAK_MS)))
+    const offpeak = def.wire!.view(def.apply(def.apply(def.init(), header('m')), usageEvt(1, 1, USAGE, OFF_PEAK_MS)))
+    expect(offpeak.total).toBeLessThan(peak.total)
